# =============================================================================
# Yojana Setu — Root .gitignore
# =============================================================================

# ── Node.js ──────────────────────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
package-lock.json

# ── Environment & Secrets (NEVER commit these) ────────────────────────────────
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env

# ── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyc
*.pyo
*.pyd
.Python
env/
venv/
.venv/
ENV/
.env/
dist/
build/
*.egg-info/
.eggs/
pip-log.txt
pip-delete-this-directory.txt

# ML Model Files (large binary files — add them to Git LFS if needed)
*.pkl
*.joblib
*.h5
*.model
backend/models/*.pkl
backend/models/*.joblib

# ── Frontend Build Output ─────────────────────────────────────────────────────
frontend/dist/
frontend/.vite/

# ── IDEs & Editors ────────────────────────────────────────────────────────────
.vscode/settings.json
.vscode/*.code-workspace
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ── Logs ─────────────────────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*

# ── OS Files ─────────────────────────────────────────────────────────────────
.DS_Store
Desktop.ini
ehthumbs.db
